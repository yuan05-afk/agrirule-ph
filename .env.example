# Copy to .env.local (local) and set the same keys in Vercel (production). Never commit real values.
# Generate a secret: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Leave DATABASE_URL empty in local development to use SQLite (db.sqlite3).
# Production: Neon pooled URL, region aws-ap-southeast-1 (Singapore).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
